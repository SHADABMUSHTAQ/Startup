    "compliance_frameworks": {
        "eto_forensic": {
            "name": "ETO 2002 Forensic Trail (Sec 5 & 6)",
            "description": "Non-repudiable log integrity and court-admissible forensic evidence under Electronic Transactions Ordinance 2002.",
            "authority": "ETO 2002 Sections 5 & 6",
            "retention": {"local_hot_days": 30, "vault_days": 365},
            "rules": [
                {"id": "ETO-101 (4625)", "event_id": 4625, "name": "Unauthorized Access Attempt (Failed Logon)", "severity": "High"},
                {"id": "ETO-102 (1102)", "event_id": 1102, "name": "Forensic Log Deletion (Audit Cleared)", "severity": "Critical"},
                {"id": "ETO-103 (4624)", "event_id": 4624, "name": "Success Logon", "severity": "Informational"},
                {"id": "ETO-104 (4688)", "event_id": 4688, "name": "Suspicious Process Creation", "severity": "Medium"},
                {"id": "ETO-105 (4672)", "event_id": 4672, "name": "Special Privileges Assigned", "severity": "Medium"},
                {"id": "ETO-106 (4720)", "event_id": 4720, "name": "Rogue Account Created", "severity": "High"},
                {"id": "ETO-107 (4726)", "event_id": 4726, "name": "Account Deleted", "severity": "High"},
                {"id": "ETO-108 (4732)", "event_id": 4732, "name": "Privilege Escalation (Group Added)", "severity": "High"},
                {"id": "ETO-109 (4697)", "event_id": 4697, "name": "Hidden Service Installation", "severity": "Critical"}
            ]
        },
        "fbr_pos": {
            "name": "FBR Point-of-Sale (SRO 288)",
            "description": "Mandatory real-time sales and modification tracking as per FBR S.R.O. 288(I)/2026.",
            "authority": "FBR S.R.O. 288(I)/2026",
            "retention": {"local_hot_days": 7, "vault_days": 30},
            "rules": [
                {"id": "FBR-101 (4660)", "event_id": 4660, "name": "Object Deleted", "severity": "Warning"},
                {"id": "FBR-102 (4663)", "event_id": 4663, "name": "File System Modification", "severity": "Alert"},
                {"id": "FBR-103 (4670)", "event_id": 4670, "name": "Permissions Changed", "severity": "High"},
                {"id": "FBR-104 (4657)", "event_id": 4657, "name": "Registry Value Modified", "severity": "High"},
                {"id": "FBR-105 (4698)", "event_id": 4698, "name": "Scheduled Task Created", "severity": "Medium"}
            ]
        }
    },
