<group name="warsoc_shadow,warsoc_integration,">
  <rule id="100510" level="0">
    <decoded_as>json</decoded_as>
    <field name="warsoc_schema">^warsoc.wazuh-local-input/v1$</field>
    <description>WarSOC minimized detection projection</description>
  </rule>

  <rule id="100511" level="9">
    <if_sid>100510</if_sid>
    <field name="warsoc_event_id">^1102$</field>
    <description>WarSOC shadow detection: Windows audit log cleared</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>audit_log_cleared,</group>
  </rule>

  <rule id="100512" level="5">
    <if_sid>100510</if_sid>
    <field name="warsoc_event_id">^4625$</field>
    <description>WarSOC shadow detection: Windows authentication failure</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100513" level="5">
    <if_sid>100510</if_sid>
    <field name="warsoc_event_id">^7045$</field>
    <description>WarSOC shadow detection: Windows service installed</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
    <group>service_installation,</group>
  </rule>

  <rule id="100514" level="3">
    <if_sid>100510</if_sid>
    <field name="warsoc_event_id">^4688$</field>
    <description>WarSOC shadow detection: Windows process created</description>
    <group>process_creation,</group>
  </rule>
</group>
