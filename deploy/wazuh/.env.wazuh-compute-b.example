# Copy to the protected runtime path as .env.wazuh-compute-b and replace every
# placeholder. Never commit the runtime file.
WAZUH_CONNECTOR_ID=wazuh-shadow-01
WAZUH_ENGINE_INSTANCE_ID=wazuh-node-01
WAZUH_ENGINE_VERSION=4.14.7
WAZUH_RULESET_VERSION=warsoc-projected-shadow-v1
WAZUH_RULE_REGISTRY_SHA256=230642e77e96279bfb1dc2c5080b8fdbb35ff3817571c5b704c326e848acbf7b

WAZUH_DISPATCH_SIGNING_SECRET=<same-64-byte-secret-as-compute-a>
WAZUH_CANDIDATE_SIGNING_SECRET=<same-64-byte-secret-as-compute-a>
WAZUH_BRIDGE_SPOOL_ENCRYPTION_KEY=<generate-a-fernet-key>

WAZUH_CANDIDATE_URL=https://warsoc-wazuh-candidate-api-prod:8010/api/v1/internal/detection-engines/wazuh/candidates
WAZUH_HEALTH_URL=https://warsoc-wazuh-candidate-api-prod:8010/api/v1/internal/detection-engines/wazuh/health
WAZUH_CANDIDATE_CA_FILE=/run/warsoc-wazuh-tls/compute-a-ca.crt
WAZUH_CANDIDATE_CERT_FILE=/run/warsoc-wazuh-tls/compute-b-client.crt
WAZUH_CANDIDATE_KEY_FILE=/run/warsoc-wazuh-tls/compute-b-client.key

WAZUH_BRIDGE_INPUT_SPOOL_MAX_BYTES=536870912
WAZUH_BRIDGE_CANDIDATE_SPOOL_MAX_BYTES=268435456
WAZUH_BRIDGE_CANDIDATE_RECORD_TTL_SECONDS=86400
WAZUH_ALERTS_INITIAL_POSITION=end

WAZUH_BRIDGE_BIND_IP=100.64.0.1
WAZUH_BRIDGE_PORT=9443
WAZUH_BRIDGE_TLS_DIR=./keys/wazuh-compute-b
WAZUH_BRIDGE_IMAGE_TAG=oci-manager-only
