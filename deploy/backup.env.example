# Store the real file at /etc/warsoc/backup.env with owner root and mode 600.
# Use a private container separate from warsoc-cold-storage. The SAS should
# permit only the minimum create/write operations required for upload.
AZURE_BACKUP_CONTAINER_SAS_URL='https://ACCOUNT.blob.core.windows.net/warsoc-db-backups?REPLACE_WITH_CONTAINER_SAS'

# Generate a unique high-entropy value and store a recovery copy outside the
# Droplet. Losing this passphrase makes every encrypted database backup useless.
BACKUP_ENCRYPTION_PASSPHRASE='REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS'

# Encrypted local copies are only a short recovery cache. Azure is authoritative.
LOCAL_RETENTION_DAYS=7
