WAZUH_BRIDGE_ENABLED=true
WAZUH_CONNECTOR_ID=wazuh-shadow-01
WAZUH_ENGINE_INSTANCE_ID=wazuh-node-01
WAZUH_ENGINE_VERSION=4.14.7
WAZUH_RULESET_VERSION=warsoc-lab-canary-v1
WAZUH_DISPATCH_SIGNING_SECRET=REPLACE_WITH_32_BYTE_MINIMUM_SECRET
WAZUH_CANDIDATE_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_32_BYTE_SECRET
WAZUH_BRIDGE_SPOOL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
WAZUH_BRIDGE_INPUT_SPOOL_MAX_BYTES=536870912
WAZUH_BRIDGE_CANDIDATE_SPOOL_MAX_BYTES=268435456
WAZUH_LIVE_EVENT_MAX_AGE_SECONDS=60
WAZUH_BRIDGE_CANDIDATE_RECORD_TTL_SECONDS=86400
WAZUH_BRIDGE_RECEIPT_RETENTION_SECONDS=604800
WAZUH_BRIDGE_HEALTH_RETENTION_SECONDS=2592000
WAZUH_BRIDGE_RETRY_BASE_SECONDS=2
WAZUH_BRIDGE_RETRY_MAX_SECONDS=300
WAZUH_MAX_BODY_BYTES=524288
WAZUH_MAX_BATCH_EVENTS=100
WAZUH_ALERTS_INITIAL_POSITION=end
WAZUH_RULE_REGISTRY_SHA256=REPLACE_WITH_SHA256_OF_RULE_REGISTRY_FILE
WAZUH_CANDIDATE_URL=https://REPLACE_PRIVATE_COMPUTE_A_HOST:8443/api/v1/internal/detection-engines/wazuh/candidates
WAZUH_HEALTH_URL=https://REPLACE_PRIVATE_COMPUTE_A_HOST:8443/api/v1/internal/detection-engines/wazuh/health
WAZUH_CANDIDATE_CA_FILE=/run/warsoc-wazuh-tls/compute-a-ca.crt
WAZUH_CANDIDATE_CERT_FILE=/run/warsoc-wazuh-tls/compute-b-client.crt
WAZUH_CANDIDATE_KEY_FILE=/run/warsoc-wazuh-tls/compute-b-client.key
WAZUH_ALERTS_VOLUME=REPLACE_WITH_WAZUH_LOGS_VOLUME_NAME
WAZUH_DOCKER_NETWORK=REPLACE_WITH_WAZUH_COMPOSE_NETWORK_NAME
WAZUH_BRIDGE_CONTAINER_IP=REPLACE_WITH_UNUSED_IP_IN_WAZUH_DOCKER_SUBNET
WAZUH_BRIDGE_BIND_IP=127.0.0.1
WAZUH_BRIDGE_PORT=9443
