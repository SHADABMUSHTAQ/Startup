# WarSOC SIEM: Backend Environment Template
# ⚠️ WARNING: DO NOT COMMIT REAL SECRETS.
# Copy this file to `.env` and replace placeholders with actual values.

# ─── Database ───
MONGO_USER=warsoc_admin
MONGO_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Connection URI (use 'mongodb' hostname for docker, '127.0.0.1' for local dev)
MONGODB_URI=mongodb://warsoc_admin:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:27017/WarSOC_DB?authSource=admin
MONGODB_DB_NAME=WarSOC_DB

# ─── Redis ───
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:6379
REDIS_MAX_CONNECTIONS=200
REDIS_POOL_TIMEOUT_SECONDS=5
# Keep Redis no-eviction and leave container headroom for AOF/allocator overhead.
REDIS_MAXMEMORY=640mb
REDIS_CONTAINER_MEMORY_LIMIT=1G
# Pending SIEM evidence is reclaimed only when fresh traffic is not waiting.
SIEM_RECLAIM_BATCH_SIZE=250
SIEM_RECLAIM_INTERVAL_SECONDS=5

# ─── Auth ───
TENANT_ID=WARSOC_XXXXXX
# 🔐 JWT Security: Rotate this and keep it safe. 32+ characters recommended.
JWT_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_SECRET
# User token lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Agent machine token lifetime in minutes (525600 = 1 year)
AGENT_TOKEN_EXPIRE_MINUTES=525600
AGENT_MASTER_SECRET=REPLACE_WITH_AGENT_MASTER_SECRET
# Use observe while upgrading existing agents, then switch to required after
# every enrolled endpoint reports a signing-capable agent version.
AGENT_EVENT_SIGNATURE_MODE=observe
# Customer-side network relay remains disabled until a reviewed tenant rollout.
# Enabling this exposes only authenticated HTTPS routes; direct cloud UDP stays disabled.
NETWORK_RELAY_ENABLED=false
NETWORK_RELAY_ACTIVATION_TTL_SECONDS=3600
NETWORK_RELAY_MAX_BATCH_EVENTS=200
NETWORK_RELAY_MAX_BODY_BYTES=1048576
NETWORK_RELAY_MAX_PER_TENANT=2
ENABLE_MANUAL_LOG_INJECTION=false
# Super Admin key for tenant provisioning (only needed by ops team)
SUPER_ADMIN_API_KEY=REPLACE_WITH_SUPER_ADMIN_KEY

# Public self-service signup must stay disabled for the enterprise sales flow.
ENABLE_SELF_SIGNUP=false

# ─── Server ───
# Set to 'production' on the DigitalOcean Droplet — enforces all security guards
APP_ENV=development
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# Comma-separated allowed origins (do NOT use localhost in production)
ALLOWED_ORIGINS=http://127.0.0.1:5173

# ─── Encryption ───
# Fernet AES key for PECA vault at-rest encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ─── Private Key (PECA Signing) ───
# Base64-encoded RSA private key PEM (for containerised / cloud deployments)
PRIVATE_KEY_B64=REPLACE_WITH_BASE64_PRIVATE_KEY

# ─── Agent Artifact Hosting ───
# Upload the compiled installer to Azure Blob/S3/CDN and set the public HTTPS URL here.
AGENT_CDN_URL=https://storage-account.blob.core.windows.net/warsoc-agent/warsoc_installer-4.2.6.exe
SALES_EMAIL=sales@warsoc.tech

# ─── Azure Cold Storage Archival ───
# Used by: python -m app.workers.storage_archiver
AZURE_STORAGE_CONNECTION_STRING=REPLACE_WITH_AZURE_STORAGE_CONNECTION_STRING
AZURE_STORAGE_CONTAINER=warsoc-cold-storage
# Optional physical retention-class separation. Leave unset to keep using the
# legacy container above. Create and lock each container before enabling it.
AZURE_STORAGE_CONTAINER_SIEM=
AZURE_STORAGE_CONTAINER_PECA=
AZURE_STORAGE_CONTAINER_FBR=
AZURE_STORAGE_CONTAINER_GENERAL=
# Optional exact-duration routing for contract-driven SIEM/general evidence.
# The suffix is the effective vault duration in days. Values are read directly
# from this env file, so repeat the pattern for any supported contract duration.
# Example: AZURE_STORAGE_CONTAINER_SIEM_90=warsoc-siem-90
# Example: AZURE_STORAGE_CONTAINER_GENERAL_180=warsoc-general-180
AZURE_IMMUTABILITY_REQUIRED=false
# Use "container" only after the Azure container policy is locked. The declared
# duration must match the actual Azure policy and cover the longest vault term.
AZURE_IMMUTABILITY_SCOPE=blob
AZURE_CONTAINER_IMMUTABILITY_LOCKED=false
AZURE_CONTAINER_IMMUTABILITY_DAYS=0
# Optional per-class policy declarations. Each value falls back to the global
# declaration above when omitted.
AZURE_CONTAINER_IMMUTABILITY_LOCKED_SIEM=
AZURE_CONTAINER_IMMUTABILITY_DAYS_SIEM=
AZURE_CONTAINER_IMMUTABILITY_LOCKED_PECA=
AZURE_CONTAINER_IMMUTABILITY_DAYS_PECA=
AZURE_CONTAINER_IMMUTABILITY_LOCKED_FBR=
AZURE_CONTAINER_IMMUTABILITY_DAYS_FBR=
AZURE_CONTAINER_IMMUTABILITY_LOCKED_GENERAL=
AZURE_CONTAINER_IMMUTABILITY_DAYS_GENERAL=
# Exact-duration policy declarations use the same suffix as the container.
# Example: AZURE_CONTAINER_IMMUTABILITY_LOCKED_SIEM_90=true
# Example: AZURE_CONTAINER_IMMUTABILITY_DAYS_SIEM_90=90
ARCHIVE_BATCH_SIZE=5000
# Archive records this many days before Mongo's explicit _expire_at TTL can remove them.
ARCHIVE_LEAD_DAYS=1
ARCHIVE_INTERVAL_SECONDS=86400
ARCHIVE_READ_MAX_BLOBS=100
# Hot Mongo windows before Azure archival. Compliance vault retention remains catalog-driven.
SIEM_HOT_RETENTION_DAYS=7
RAW_LOG_HOT_RETENTION_DAYS=7
# Daily tenant ingest guardrail. Override per tenant with tenant_ingest_quota_bytes in Redis/provisioning.
MAX_TENANT_AGENTS=50
PASSWORD_MIN_LENGTH=16
INGEST_DAILY_BYTES_PER_AGENT=52428800
INGEST_DAILY_BYTES_FLOOR=1073741824
INGEST_DAILY_BYTES_MAX=3221225472
INGEST_DAILY_QUOTA_TTL_SECONDS=259200
# Admission control stops Redis memory growth without trimming unacknowledged events.
RAW_STREAM_MAX_ENTRIES=500000

# Future-only Linux/network intake. The production service remains disabled unless
# the explicit network-syslog Compose profile is enabled after a separate review.
SYSLOG_BIND=127.0.0.1
SYSLOG_ALLOWED_SOURCES=

# ─── Transactional Email (Zoho Mail) ───
# Use an App Password if 2FA is enabled on the Zoho account
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=alerts@yourdomain.com
ZOHO_SMTP_PASS=REPLACE_WITH_ZOHO_APP_PASSWORD
# Keep transactional mail (quotes, contacts and team invitations) enabled while
# suppressing high-volume SIEM/FBR/PECA alert emails.
ENABLE_SECURITY_ALERT_EMAILS=false

# ─── Threat Intel ───
# VirusTotal API key — leave empty to disable (graceful fallback to Neutral)
VT_API_KEY=REPLACE_WITH_VT_KEY_IF_ENABLED
# AbuseIPDB API key — leave empty to disable
ABUSEIPDB_API_KEY=REPLACE_WITH_ABUSEIPDB_KEY_IF_ENABLED

# ─── Observability ───
# Bearer token to protect the /metrics Prometheus endpoint
METRICS_BEARER_TOKEN=REPLACE_WITH_METRICS_TOKEN
# Comma-separated IPs allowed to scrape /metrics without token
METRICS_ALLOWLIST_IPS=127.0.0.1,::1
