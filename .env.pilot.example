# WarSOC Pilot Environment Template
# Copy to `.env.pilot`, replace every placeholder, and run compose with:
#   docker compose --env-file .env.pilot up -d
# For service-level env_file loading, set WARSOC_ENV_FILE=.env.pilot in your shell or this file.

WARSOC_ENV_FILE=.env.pilot
APP_ENV=production

MONGO_USER=warsoc_admin
MONGO_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MONGODB_DB_NAME=WarSOC_DB
MONGODB_URI=mongodb://warsoc_admin:REPLACE_WITH_STRONG_PASSWORD@mongodb:27017/WarSOC_DB?authSource=admin

REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379

JWT_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_SECRET
SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
AGENT_TOKEN_EXPIRE_MINUTES=15
PROVISIONING_TOKEN_EXPIRE_MINUTES=60
SUPER_ADMIN_API_KEY=REPLACE_WITH_HIGH_ENTROPY_ADMIN_KEY

BACKEND_PUBLIC_URL=https://api.warsoc.example
ALLOWED_ORIGINS=https://app.warsoc.example
TRUSTED_PROXY_HOSTS=172.28.0.10,127.0.0.1,::1,localhost
ENABLE_LEGACY_ROUTES=false
METRICS_ALLOWLIST_IPS=127.0.0.1,::1,172.28.0.0/16
METRICS_BEARER_TOKEN=REPLACE_WITH_OPTIONAL_METRICS_TOKEN

ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_FERNET_OR_APP_KEY
PRIVATE_KEY_B64=REPLACE_WITH_BASE64_RSA_PRIVATE_KEY_FOR_PILOT
PRIVATE_KEY_PASSWORD=

VT_API_KEY=
