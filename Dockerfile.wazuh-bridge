FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TZ=UTC

WORKDIR /app

COPY requirements-wazuh-bridge.txt ./
RUN pip install --no-cache-dir --upgrade \
        pip \
        setuptools==83.0.0 \
        wheel==0.46.2 && \
    pip install --no-cache-dir -r requirements-wazuh-bridge.txt

COPY app/__init__.py ./app/__init__.py
COPY app/wazuh_integration ./app/wazuh_integration

RUN adduser --disabled-password --gecos '' warsoc-bridge && \
    chown -R warsoc-bridge:warsoc-bridge /app

USER warsoc-bridge

EXPOSE 8020
